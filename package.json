{
  "type": "module",
  "private": "true",
  "version": "0.0.0",
  "main": "public/index.js",
  "scripts": {
    "dev": "npm start",
    "lint": "eslint \"./**/*.{ts,js,tsx}\"",
    "test": "vitest run",
    "test:typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:open": "vitest --ui",
    "build": "rm -rf ./public && mkdir -p ./public/client && echo '{}' > ./public/client/vite-manifest.json && vite build",
    "start": "vite",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "reset": "rm -rf .wrangler/state",
    "preversion": "npm run lint",
    "version": "auto-changelog --template keepachangelog --breaking-pattern 'BREAKING CHANGE' && git add CHANGELOG.md",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@preact/signals": "^2.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@substrate-system/a11y": "^0.0.17",
    "@substrate-system/blur-hash": "^0.0.35",
    "@substrate-system/button": "^0.0.36",
    "@substrate-system/copy-button": "^0.5.24",
    "@substrate-system/css-normalize": "^0.0.13",
    "@substrate-system/dialog": "^0.0.28",
    "@substrate-system/hamburger-two": "^0.0.13",
    "@substrate-system/input": "^0.0.22",
    "@substrate-system/password-input": "^0.0.4",
    "@substrate-system/radio-input": "^0.0.11",
    "@substrate-system/routes": "^5.0.5",
    "@substrate-system/state": "^0.1.0",
    "@substrate-system/text-input": "^0.1.7",
    "hono": "^4.12.8",
    "htm": "^3.1.1",
    "ky": "^1.14.3",
    "nanoid": "^5.1.6",
    "nanoid-dictionary": "^5.0.0",
    "preact": "^10.28.3",
    "route-event": "^7.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.28.0",
    "@cloudflare/vitest-pool-workers": "^0.13.0",
    "@cloudflare/workers-types": "^4.20260313.1",
    "@hono/vite-dev-server": "^0.25.1",
    "@substrate-system/debug": "^0.9.38",
    "@substrate-system/dom": "^0.1.13",
    "@substrate-system/tapzero": "^0.10.16",
    "@types/node": "^25.0.9",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/ui": "^4.1.0",
    "auto-changelog": "^2.4.0",
    "browserslist": "^4.28.1",
    "concurrently": "^9.1.2",
    "esbuild": "^0.27.4",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "lightningcss": "^1.32.0",
    "markdown-toc": "^1.2.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^39.0.1",
    "tap-spec": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.73.0"
  },
  "author": "nichoth <nichoth@nichoth.com> (https://nichoth.com)"
}
