/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "template-hono-spa",
	"main": "src/server/index.ts", // hono entry
	// "placement": { "mode": "smart" },
	"compatibility_date": "2025-12-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [],
	"ratelimits": [
		{
			"name": "INVITE_RATE_LIMIT",
			"namespace_id": "1",  // unique per CF account
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "template-hono-spa-auth",
			"database_id": "5bbd01f8-edd4-41b3-9068-fd768d1d37dd"
		},
	],
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	"assets": {
		"directory": "./public/", // SPA build output
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true // try route matching on the server first
	},
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"NODE_ENV": "production",
		"DOMAIN": "template-hono-spa.nichoth.workers.dev",
		// The default deploy is the public production environment.
		"MAIN_BRANCH": "main",
		"DEPLOY_BRANCH": "main",
		"BASIC_AUTH_REALM": "Staging",
		"AUTH_SESSION_TTL_SECONDS": "2592000",
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 9999
	},
	/**
	 * Environments
	 * https://developers.cloudflare.com/workers/wrangler/environments/
	 *
	 * Deploy staging with: wrangler deploy --env staging
	 * Set secrets with:
	 *   wrangler secret put STAGING_USERNAME --env staging
	 *   wrangler secret put STAGING_PW --env staging
	 */
	"env": {
		"staging": {
			"name": "staging-template-hono-spa",
			"d1_databases": [
				{
					"binding": "staging_template_hono_spa_auth",
					"database_name": "staging-template-hono-spa-auth",
					"database_id": "eeed6191-33f0-4656-9ce1-348baeb9027d"
				},
			],
			"rate_limiting": [
				{
					"binding": "INVITE_RATE_LIMIT",
					"namespace_id": "2",
					"simple": {
						"limit": 10,
						"period": 60
					}
				}
			],
			"vars": {
				"NODE_ENV": "production",
				"DOMAIN": "staging-template-hono-spa.nichoth.workers.dev",
				"MAIN_BRANCH": "main",
				// Only the staging branch deploy is password protected.
				"DEPLOY_BRANCH": "staging",
				"BASIC_AUTH_REALM": "Staging",
				"AUTH_SESSION_TTL_SECONDS": "2592000",
			}
		}
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the
	 * Cloudflare Developer Platform, including databases, object storage,
	 * AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
