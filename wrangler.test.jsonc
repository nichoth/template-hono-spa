{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "template-hono-preact-test",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-12-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./_public/",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "template-hono-spa-auth-test",
      "database_id": "33333333-3333-3333-3333-333333333333",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NODE_ENV": "test",
    "MAIN_BRANCH": "main",
    "DEPLOY_BRANCH": "main",
    "BASIC_AUTH_REALM": "Staging",
    "STAGING_BASIC_AUTH_USERNAME": "staging-user",
    "STAGING_PW": "staging-pass",
    "AUTH_SESSION_TTL_SECONDS": "2592000"
  }
}
